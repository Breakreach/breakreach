{
  "name": "breakreach",
  "version": "0.1.0",
  "description": "Official Breakreach SDK and CLI: schedule and publish social media posts to Instagram, TikTok, X, LinkedIn, YouTube, Facebook, Threads, Pinterest, Bluesky, Reddit and 5 more networks with one API.",
  "keywords": ["breakreach", "social media api", "social media scheduler", "instagram api", "tiktok api", "linkedin api", "x api", "schedule posts", "cli", "sdk"],
  "homepage": "https://www.breakreach.com/developers",
  "bugs": "https://github.com/breakreach/breakreach/issues",
  "repository": { "type": "git", "url": "git+https://github.com/breakreach/breakreach.git", "directory": "typescript" },
  "license": "MIT",
  "author": "Breakreach (https://www.breakreach.com)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "bin": { "breakreach": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18.17" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0"
  }
}
